# Copy to .env (gitignored, loaded by mise) for `mise run judge:run` and
# a real `ci-judge run` from a shell. Never commit .env.
#
# The System One backend, as the jud command reads it; or put base_url,
# model and api_key in ~/.config/jud/config.yaml instead.
TYPESAFE_API_KEY=
# TYPESAFE_BASE_URL=http://localhost:8000     # any server that speaks POST /v1/systemone
#
# Platform tokens, for the collectors that need more than the job token
# and for the gate's note or comment.
# GITLAB_TOKEN=
# GITHUB_TOKEN=
